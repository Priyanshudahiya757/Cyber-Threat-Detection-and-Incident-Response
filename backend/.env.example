# Copy this file to backend/.env and fill in real values.
# .env itself must NEVER be committed — only .env.example.

# docker-compose.yml always runs the backend with APP_ENV=production and
# DEBUG=false; these two lines only apply when you run uvicorn directly.
APP_ENV=development
DEBUG=true

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- MongoDB ---
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=siem_dashboard

# --- Elasticsearch ---
ELASTIC_HOST=http://elasticsearch:9200
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTIC_LOG_INDEX_PREFIX=security-logs
ELASTIC_VERIFY_CERTS=false

# --- JWT ---
# REQUIRED: the backend refuses to start in production with the placeholder.
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Login brute-force protection ---
# After this many failed logins for one username, it is locked for the lockout period.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Detection ---
# Stored logs from this many minutes before a new upload are evaluated with it,
# so an attack split across uploads is still detected. 0 disables this.
DETECTION_LOOKBACK_MINUTES=10
# A repeat alert for the same entity and threat is suppressed for this long.
ALERT_COOLDOWN_MINUTES=30

# --- Alert delivery (all optional; leave a channel blank to disable it) ---
# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=[]
# Discord: Server Settings -> Integrations -> Webhooks -> copy the webhook URL
DISCORD_WEBHOOK_URL=
# Telegram: create a bot with @BotFather, then use the chat's numeric id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ML ---
ML_MODEL_DIR=./ml/models

# --- Ingestion ---
MAX_UPLOAD_FILE_SIZE_MB=25

# --- Bootstrap admin (used only by scripts/seed_admin.py and seed_demo_data.py) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
