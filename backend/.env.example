# Copy this file to backend/.env and fill in real values.
# .env itself must NEVER be committed — only .env.example.

APP_ENV=development
DEBUG=true

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- MongoDB ---
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=siem_dashboard

# --- Elasticsearch ---
ELASTIC_HOST=http://elasticsearch:9200
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTIC_LOG_INDEX_PREFIX=security-logs
ELASTIC_VERIFY_CERTS=false

# --- JWT ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Email alerts (Phase 7) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=[]

# --- Webhook alerts (Phase 7) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ML (Phase 6) ---
ML_MODEL_DIR=./ml/models
ML_MODEL_VERSION=v1

# --- Ingestion ---
MAX_UPLOAD_FILE_SIZE_MB=25

# --- Bootstrap admin (used only by scripts/seed_admin.py) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
