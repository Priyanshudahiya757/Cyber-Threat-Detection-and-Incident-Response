# Copy to .env.local for local development.
# In dev, Vite's proxy (vite.config.ts) forwards /api/* to the backend, so
# VITE_API_BASE_URL can stay relative. In production, point it at the real
# backend origin (e.g. https://api.yourdomain.com).
VITE_API_BASE_URL=/api/v1

# Backend origin the dev proxy forwards to (not read by the app itself,
# only by vite.config.ts at dev-server startup).
VITE_BACKEND_ORIGIN=http://localhost:8000

# Toggles the mock-data fallback for endpoints the backend hasn't
# implemented yet (incidents, analytics, rule config, users, settings —
# see src/services/*Service.ts for which calls this affects). Set to
# "false" once those backend phases land, with zero UI changes required.
VITE_USE_MOCKS_FOR_UNIMPLEMENTED=false
