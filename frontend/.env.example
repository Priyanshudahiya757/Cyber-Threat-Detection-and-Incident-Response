# Only needed for local development with `npm run dev`. Copy to .env.local.
# The Docker image needs none of this: nginx serves the built app and
# proxies /api to the backend (see nginx.conf).

# Base path the app sends API requests to. Keep it relative so requests go
# through the dev server's proxy (vite.config.ts) and stay same-origin.
VITE_API_BASE_URL=/api/v1

# Where the dev server's proxy forwards /api and /health. Read by
# vite.config.ts at startup, not by the app itself.
VITE_BACKEND_ORIGIN=http://localhost:8000
